#!/usr/bin/env bash
# Stands in for mason in the specs, set up by fresh_gh in test/utils/gh.sh. Logs each call, and make
# exits ${MASON_RC}, writing an empty ci caller into its --output-dir when that's 70 for a change.
# shellcheck disable=SC2154  # fresh_gh exports what this reads
echo "mason $*" >> "${CALLS}"
if [[ $1 != make ]]; then exit 0; fi
out='' prev=''
for arg; do
  if [[ ${prev} == --output-dir ]]; then out="${arg}"; fi
  prev="${arg}"
done
case "${MASON_RC}" in
  0) ;;
  70)
    mkdir -p "${out}/.github/workflows"
    : > "${out}/.github/workflows/ci.yml"
    ;;
  *) echo "mason stand-in failed" >&2 ;;
esac
exit "${MASON_RC}"
