#!/usr/bin/env bash
# shellcheck disable=SC2154  # fresh_gh exports what this reads
echo "mason $*" >> "${CALLS}"
if [[ $1 != make ]]; then
  prev=''
  for arg; do
    # The staged copy is gone before a spec can look, so the name gets taken while it is there.
    if [[ ${prev} == --path && -f "${arg}/brick.yaml" ]]; then
      sed -n 's/^name: //p' "${arg}/brick.yaml" >> "${BRICKS}"
    fi
    prev="${arg}"
  done
  exit 0
fi
out='' prev=''
for arg; do
  if [[ ${prev} == --output-dir ]]; then out="${arg}"; fi
  prev="${arg}"
done
case "${MASON_RC}" in
  0) ;;
  70)
    mkdir -p "${out}/.github/workflows"
    : > "${out}/.github/workflows/ci.yml"
    echo '{"image":"img","checks":[{"name":"a","cmd":"a"}]}' > "${out}/.github/lint-checks.json"
    ;;
  *) echo "mason stand-in failed" >&2 ;;
esac
exit "${MASON_RC}"
