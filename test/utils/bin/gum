#!/usr/bin/env bash
# Stands in for gum in the specs, set up by fresh_gh in test/utils/gh.sh. Logs each call and says yes,
# except no to a question matching ${DECLINE_ON} and ctrl+c at one matching ${ABORT_ON}.
# shellcheck disable=SC2154  # fresh_gh exports what this reads
echo "gum $*" >> "${CALLS}"
if [[ -n ${ABORT_ON} && "$*" == *"${ABORT_ON}"* ]]; then exit 130; fi
if [[ -n ${DECLINE_ON} && "$*" == *"${DECLINE_ON}"* ]]; then exit 1; fi
