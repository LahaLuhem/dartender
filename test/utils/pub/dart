#!/usr/bin/env bash
# shellcheck disable=SC2154  # pub_lists, pub_fails and pub_outdated export what this reads
case "$*" in
  'pub workspace list --json')
    if [[ -n ${PUB_FAILS} ]]; then
      echo "${PUB_FAILS}" >&2
      exit 66
    fi
    # pub prints resolved paths.
    root="$(pwd -P)"
    jq -n --arg root "${root}" --arg listed "${LISTED}" '{packages: [$listed | split(" ")[]
      | split(":") | {name: .[0], path: (if .[1] == "." then $root else "\($root)/\(.[1])" end)}]}'
    ;;
  'pub outdated --json')
    if [[ -n ${PUB_FAILS} ]]; then
      echo "${PUB_FAILS}" >&2
      exit 66
    fi
    # Only what can still move, the way pub leaves out a package already at its newest.
    jq -n --arg outdated "${OUTDATED}" '{packages: [$outdated | split(" ")[] | select(. != "")
      | split(":") | {package: .[0], kind: .[1], latest: {version: .[2]}}]}'
    ;;
  'pub add '*)
    root="$(pwd -P)"
    printf '%s %s\n' "${root}" "$*" >> "${ADDED}"
    ;;
  *)
    echo "The dart stand-in doesn't know: dart $*" >&2
    exit 1
    ;;
esac
